// [AI] Claude (Opus 5.5), prompt: "Vytvor mi dalsi testy pokryvajici vsechna rozsireni dle specifikace i okrajove pripady. (Vsechna krom Interpolateds, ty zatim nebudou podporovany)"
// LISTS: List(...), indexace, print, toStr a toString, prazdny seznam, String, Double a Boolean prvky, List.range (spec 5.8)
import ifj26.*

@main def main(): Unit =
  val lst = List(10, 20, 30)
  val a = lst(0)
  val c = lst(2)
  print(a)
  print(" ")
  print(c)
  print("\n")
  print(lst)
  print("\n")
  val s = toStr(lst)
  print(s)
  print("\n")
  val s2 = lst.toString
  print(s2)
  print("\n")
  val e: List[Int] = List()
  print(e)
  print("\n")
  val w = List("a", "bc")
  print(w)
  print("\n")
  val d = List(1, 2.5)
  print(d)
  print("\n")
  val b = List(true, false)
  print(b)
  print("\n")
  val r = List.range(1, 10)
  val x = r(2)
  print(x)
  print("\n")
