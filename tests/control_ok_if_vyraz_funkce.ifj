// [AI] Claude (Opus 5.5), prompt: "Vytvor mi dalsi testy pokryvajici vsechna rozsireni dle specifikace i okrajove pripady. (Vsechna krom Interpolateds, ty zatim nebudou podporovany)"
// CONTROL: if-vyraz jako telo funkce, retez else if ve vyrazu, jednoradkova tela prikazu if (spec 5.3)
import ifj26.*

def sign(x: Int): Int = if x < 0 then -1 else if x == 0 then 0 else 1

def maxOf(a: Int, b: Int) =
  if a > b then
    a
  else
    b

@main def main(): Unit =
  val p = -7
  val z = 0
  val q = 4
  val s1 = sign(p)
  val s2 = sign(z)
  val s3 = sign(q)
  print(s1)
  print(" ")
  print(s2)
  print(" ")
  print(s3)
  print("\n")
  val m = maxOf(p, q)
  print(m)
  print("\n")
  if q > 0 then print("kladne") else print("zaporne")
  print("\n")
  if q > 10 then print("velke") else if q > 2 then print("stredni") else print("male")
  print("\n")
