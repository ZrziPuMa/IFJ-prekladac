// [AI] Claude (Opus 5.5), prompt: "Vytvor mi E2E testy s vypisy TokenDump ze zakladni IFJ26 sestavy ze specifikace bez rozsireni."
// ukazka ze specifikace IFJ26, kap. 2 (komentare bez diakritiky, testy jsou jen ASCII)
import ifj26.*

def factorial(n: Int): Int =
  var result = 1
  var i: Int = n // uvedeni typu je nepovinne
  while i > 1 do
    result = result * i
    i = i - 1
  result // posledni vyraz v tele funkce urci navratovou hodnotu

@main def runFoo(): Unit =
  val n = readInt()
  val result = factorial(n)
  print(result)
  print("\n")
