// radkovy komentar pred prologem
import ifj26.* // komentar za prologem

/* komentar mezi definicemi */
def sum3(a: Int,
         b: Int,
         c: Int): Int =
  a + b + c /* komentar bez LF */ // a jeste radkovy

@main
def main(): Unit =

  // prazdne a komentarove radky nemeni odsazeni

  val one = 1; val two = 2
  val s = sum3(
      one,
      two,
      one,
    )
  print(s)
  print("\n")
