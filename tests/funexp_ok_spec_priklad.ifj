// [AI] Claude (Opus 5.5), prompt: "Vytvor mi dalsi testy pokryvajici vsechna rozsireni dle specifikace i okrajove pripady. (Vsechna krom Interpolateds, ty zatim nebudou podporovany)"
// FUNEXP: priklad ze specifikace 5.1 (volani ve vyrazu, vnorena volani vestavenych funkci)
import ifj26.*

def factorial(n: Int): Int =
  if n <= 1 then
    return 1
  else
    return n * factorial(n - 1)

@main def main(): Unit =
  val result = 2 * factorial(readInt() + 1)
  print(toStr(result + strLength(subStr("abcd", 1, 3))))
  print("\n")
