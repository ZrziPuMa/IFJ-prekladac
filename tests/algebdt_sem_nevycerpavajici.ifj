// ALGEBDT: match bez case _ a nepokryvajici zaporna cisla neni vycerpavajici (spec 5.5 a 6)
import ifj26.*

def f(n: Int): String =
  n match
    case 0 => "nula"
    case x: Int if x > 0 => "kladne"

@main def main(): Unit =
  val r = f(1)
  print(r)
