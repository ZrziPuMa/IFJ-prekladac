// [AI] Claude (Opus 5.5), prompt: "Vytvor mi E2E testy s vypisy TokenDump ze zakladni IFJ26 sestavy ze specifikace bez rozsireni."
// bloky: if/else i vnoreny, while, prazdna vetev (), strednik, prekryti promenne (spec 2.1, 2.2, 2.4, 2.5)
import ifj26.*

def classify(x: Int): Unit =
  if x < 0 then
    print("zaporne")
  else
    if x == 0 then
      print("nula")
    else
      print("kladne")

@main def main(): Unit =
  var i = -1
  while i <= 1 do
    classify(i)
    print(" ")
    i = i + 1
  print("\n")
  var count = 0
  var j = 1
  while j <= 20 do
    val rest = j - j / 3 * 3
    if rest == 0 then
      count = count + 1
    else
      ()
    j = j + 1
  print(count); print("\n")
  val x = 1
  if x == 1 then
    val x = "stineno"
    print(x)
  else
    print("chyba")
  print(" ")
  print(x)
  print("\n")
