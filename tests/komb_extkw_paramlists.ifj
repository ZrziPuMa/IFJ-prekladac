// [AI] Claude (Opus 5.5), prompt: "Vytvor mi dalsi testy pokryvajici vsechna rozsireni dle specifikace i okrajove pripady. (Vsechna krom Interpolateds, ty zatim nebudou podporovany)"
// EXTKW + PARAMLISTS: rozsirujici metoda s vice seznamy parametru (spec 5.10)
import ifj26.*

extension (v: Int)
  def between(lo: Int)(hi: Int): Boolean = v >= lo && v <= hi

@main def main(): Unit =
  val n = 5
  val a = n.between(1)(10)
  val b = n.between(6)(10)
  print(a)
  print(" ")
  print(b)
  print("\n")
